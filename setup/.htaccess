# Desta pasta, só o instalador responde pela web.
# Os .sql revelam a estrutura do banco e não têm por que ficar baixáveis.

<IfModule mod_authz_core.c>
  # Apache 2.4
  <FilesMatch ".">
    Require all denied
  </FilesMatch>
  <FilesMatch "^instalar\.php$">
    Require all granted
  </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
  # Apache 2.2 (hospedagens antigas)
  <FilesMatch ".">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <FilesMatch "^instalar\.php$">
    Order deny,allow
    Allow from all
  </FilesMatch>
</IfModule>
